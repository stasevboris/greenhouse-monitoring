@model IEnumerable<IdentityUser>
@inject UserManager<IdentityUser> UserManager
@{
    ViewData["Title"] = "Управление пользователями";
}

<h2 class="mb-4">Администрирование пользователей</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<a asp-action="Create" class="btn btn-success mb-3">
    + Добавить пользователя
</a>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Пользователей пока нет. <a asp-action="Create">Создать первого</a>
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Email</th>
                <th>Роль</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var roles = await UserManager.GetRolesAsync(user);
                var userRole = roles.FirstOrDefault() ?? "User";
                var isCurrentUser = user.Email == User.Identity?.Name;

                <tr>
                    <td>
                        <strong>@user.Email</strong>
                        @if (isCurrentUser)
                        {
                            <span class="badge bg-info text-dark ms-2">Вы</span>
                        }
                    </td>
                    <td>
                        <span class="badge bg-secondary">@userRole</span>
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary">Edit</a>

                            @if (!isCurrentUser)
                            {
                                <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger"
                                            onclick="return confirm('Удалить пользователя @user.Email?')">
                                        Delete
                                    </button>
                                </form>
                            }
                            else
                            {
                                <em class="text-muted small">Нельзя удалить себя</em>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}