@model GreenhouseMonitoring.Models.SensorReading
@{
    ViewData["Title"] = "Добавить показание";
}

<h2>Новое показание датчика</h2>

<form asp-action="Create">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Датчик</label>
                        <select asp-for="SensorId" class="form-select" required>
                            <option value="">— Выберите датчик —</option>
                            @if (ViewBag.Sensors != null)
                            {
                                @foreach (var sensor in ViewBag.Sensors)
                                {
                                    <option value="@sensor.Value">@sensor.Text</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="SensorId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Value" class="form-label">Значение</label>
                        <input asp-for="Value" class="form-control" type="number" step="0.01" required />
                        <span asp-validation-for="Value" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Timestamp" class="form-label">Время</label>
                        <input asp-for="Timestamp" class="form-control" type="datetime-local" required />
                        <span asp-validation-for="Timestamp" class="text-danger"></span>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success">Добавить показание</button>
                        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}