@model IEnumerable<GreenhouseMonitoring.Models.SensorReading>
@using GreenhouseMonitoring.ViewModels
@{
    ViewData["Title"] = "Показания датчиков";
    var filter = ViewBag.CurrentFilter as ReadingsFilter ?? new ReadingsFilter();
    var currentSensorId = filter.SensorId ?? 0;
}

<h2>Показания датчиков</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-3 align-items-center">
    <div class="col-md-6">
        @if (User.IsInRole("Administrator"))
        {
            <a asp-action="Create" class="btn btn-success">
                + Добавить показание
            </a>
        }
    </div>
    <div class="col-md-6 text-end">
        <form asp-action="Index" method="get" class="d-inline">
            <div class="input-group">
                <span class="input-group-text">Датчик:</span>
                <select name="sensorId" class="form-select" asp-items="ViewBag.Sensors" onchange="this.form.submit()">
                    <option value="">— Все датчики —</option>
                </select>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Показаний пока нет.
        @if (User.IsInRole("Administrator"))
        {
            <text> <a asp-action="Create">Добавить первое</a></text>
        }
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Время</th>
                <th>Датчик</th>
                <th>Значение</th>
                <th>Теплица</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Timestamp.ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td>
                        <span class="badge bg-secondary">@r.Sensor?.Type</span>
                        @(r.Sensor?.Model != null ? $" ({r.Sensor.Model})" : "")
                    </td>
                    <td>
                        <strong class="@(r.Value < 0 ? "text-danger" : r.Value > 100 ? "text-warning" : "")">
                            @r.Value
                        </strong>
                    </td>
                    <td>@(r.Sensor?.Greenhouse?.NameNumber ?? "—")</td>
                    <td>
                        @if (User.IsInRole("Administrator"))
                        {
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Edit" asp-route-id="@r.ReadingId" class="btn btn-outline-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@r.ReadingId" class="btn btn-outline-danger">Delete</a>
                            </div>
                        }
                        else
                        {
                            <em class="text-muted small">Только администратору</em>
                        }
                        <a asp-action="Chart" asp-route-sensorId="@r.SensorId" class="btn btn-outline-primary btn-sm ms-1">График</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
