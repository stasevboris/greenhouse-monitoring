@model GreenhouseMonitoring.Models.NormativeParameter
@{
    ViewData["Title"] = "Добавить норматив";
}

<h2>Новый нормативный параметр</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <strong>Ошибки:</strong>
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="CropId" class="form-label">Культура <span class="text-danger">*</span></label>
                        <select asp-for="CropId" class="form-select" asp-items="ViewBag.Crops">
                            <option value="">— Выберите культуру —</option>
                        </select>
                        <span asp-validation-for="CropId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Parameter" class="form-label">Параметр <span class="text-danger">*</span></label>
                        <input asp-for="Parameter" class="form-control" placeholder="Temperature, Humidity, CO2, Light" />
                        <span asp-validation-for="Parameter" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="MinValue" class="form-label">Минимальное значение</label>
                                <input asp-for="MinValue" class="form-control" step="0.01" />
                                <span asp-validation-for="MinValue" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="MaxValue" class="form-label">Максимальное значение</label>
                                <input asp-for="MaxValue" class="form-control" step="0.01" />
                                <span asp-validation-for="MaxValue" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GrowthStage" class="form-label">Стадия роста</label>
                        <input asp-for="GrowthStage" class="form-control" placeholder="Всходы, Цветение, Плодоношение" />
                        <span asp-validation-for="GrowthStage" class="text-danger"></span>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success">Добавить норматив</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">Отмена</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}