@model GreenhouseMonitoring.Models.Sensor
@{
    ViewData["Title"] = "Редактировать датчик";
}

<h2>Редактировать датчик</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.SensorId)
    @Html.HiddenFor(m => m.CreatedAt)

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Type" class="form-label">Тип датчика</label>
                        <select asp-for="Type" class="form-select">
                            <option>Temperature</option>
                            <option>Humidity</option>
                            <option>Light</option>
                            <option>CO2</option>
                            <option>pH</option>
                            <option>SoilMoisture</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Model" class="form-label">Модель</label>
                        <input asp-for="Model" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="LocationInGh" class="form-label">Положение</label>
                        <input asp-for="LocationInGh" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="GreenhouseId" class="form-label">Теплица</label>
                        <select asp-for="GreenhouseId" class="form-select" asp-items="ViewBag.Greenhouses"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Создан</label>
                        <input class="form-control" value="@Model.CreatedAt?.ToString("dd.MM.yyyy HH:mm")" disabled />
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">Отмена</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}