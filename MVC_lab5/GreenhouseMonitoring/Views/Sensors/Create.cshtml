@model GreenhouseMonitoring.Models.Sensor
@{
    ViewData["Title"] = "Добавить датчик";
}

<h2>Новый датчик</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Type" class="form-label">Тип датчика <span class="text-danger">*</span></label>
                        <select asp-for="Type" class="form-select" required>
                            <option value="">— Выберите тип —</option>
                            <option>Temperature</option>
                            <option>Humidity</option>
                            <option>Light</option>
                            <option>CO2</option>
                            <option>pH</option>
                            <option>SoilMoisture</option>
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Model" class="form-label">Модель</label>
                        <input asp-for="Model" class="form-control" placeholder="Например: DHT22, SHT31" />
                        <span asp-validation-for="Model" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LocationInGh" class="form-label">Положение в теплице</label>
                        <input asp-for="LocationInGh" class="form-control" placeholder="Центр, Северный угол, Под потолком" />
                        <span asp-validation-for="LocationInGh" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GreenhouseId" class="form-label">Теплица <span class="text-danger">*</span></label>
                        <select asp-for="GreenhouseId" class="form-select" asp-items="ViewBag.Greenhouses" required>
                            <option value="">— Выберите теплицу —</option>
                        </select>
                        <span asp-validation-for="GreenhouseId" class="text-danger"></span>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success">Добавить датчик</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">Отмена</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}