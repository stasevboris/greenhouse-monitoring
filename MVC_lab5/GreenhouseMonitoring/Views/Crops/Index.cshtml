@model IEnumerable<GreenhouseMonitoring.Models.Crop>
@{
    ViewData["Title"] = "Культуры";
}

<h2>Культуры</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<a asp-action="Create" class="btn btn-success mb-3">+ Добавить культуру</a>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Теплиц</th>
            <th>Нормативов</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CropId</td>
                <td><strong>@item.Name</strong></td>
                <td>
                    <span class="badge bg-primary">@item.Greenhouses.Count</span>
                </td>
                <td>
                    <span class="badge bg-info">@item.NormativeParameters.Count</span>
                </td>
                <td>
                    @if (User.IsInRole("Administrator"))
                    {
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit"
                               asp-route-id="@item.CropId"
                               class="btn btn-outline-warning"
                               title="Редактировать">
                                Edit
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@item.CropId"
                               class="btn btn-outline-danger"
                               title="Удалить">
                                Delete
                            </a>
                        </div>
                    }
                    else
                    {
                        <em class="text-muted small">Только для администратора</em>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info mt-4">
        Культур пока нет. <a asp-action="Create">Добавить первую</a>
    </div>
}