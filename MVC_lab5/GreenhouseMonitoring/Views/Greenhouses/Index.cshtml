@model IEnumerable<GreenhouseMonitoring.Models.Greenhouse>
@{
    ViewData["Title"] = "Теплицы";
}

<h2>Теплицы</h2>

<!-- Уведомления -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Кнопка добавления — только для админа -->
@if (User.IsInRole("Administrator"))
{
    <a asp-action="Create" class="btn btn-success mb-3">
        + Добавить теплицу
    </a>
}
else
{
    <div class="mb-3"></div> <!-- просто отступ, чтобы не было "прыжка" -->
}

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Номер/Название</th>
            <th>Местоположение</th>
            <th>Культура</th>
            <th>Датчиков</th>
            <th>Создана</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in Model)
        {
            <tr>
                <td>@g.GreenhouseId</td>
                <td><strong>@g.NameNumber</strong></td>
                <td>@(g.Location ?? "—")</td>
                <td>
                    @if (g.Crop != null)
                    {
                        <span class="badge bg-secondary">@g.Crop.Name</span>
                    }
                    else
                    {
                        <em class="text-muted">Не указана</em>
                    }
                </td>
                <td>
                    <span class="badge bg-primary rounded-pill">@g.Sensors.Count</span>
                </td>
                <td>@g.CreatedAt?.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (User.IsInRole("Administrator"))
                    {
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit"
                               asp-route-id="@g.GreenhouseId"
                               class="btn btn-outline-warning"
                               title="Редактировать">
                                Edit
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@g.GreenhouseId"
                               class="btn btn-outline-danger"
                               title="Удалить">
                                Delete
                            </a>
                        </div>
                    }
                    <a asp-action="Report" 
                       asp-route-id="@g.GreenhouseId" 
                       class="btn btn-outline-info btn-sm ms-1">
                        Отчёт
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Если теплиц нет -->
@if (!Model.Any())
{
    <div class="alert alert-info mt-4">
        Теплиц пока нет.
        @if (User.IsInRole("Administrator"))
        {
            <text> <a asp-action="Create">Добавьте первую</a></text>
        }
    </div>
}