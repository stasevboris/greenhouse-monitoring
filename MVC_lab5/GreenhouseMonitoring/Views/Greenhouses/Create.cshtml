@model GreenhouseMonitoring.Models.Greenhouse
@{
    ViewData["Title"] = "Создать теплицу";
}

<h2>Новая теплица</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="NameNumber" class="form-label">Номер/Название</label>
                        <input asp-for="NameNumber" class="form-control" placeholder="Например: Теплица №5" />
                        <span asp-validation-for="NameNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Location" class="form-label">Местоположение</label>
                        <input asp-for="Location" class="form-control" placeholder="Например: Участок А, ряд 3" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CropId" class="form-label">Культура</label>
                        <select asp-for="CropId" class="form-select" asp-items="ViewBag.Crops">
                            <option value="">— Не выбрана —</option>
                        </select>
                        <span asp-validation-for="CropId" class="text-danger"></span>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success">Создать теплицу</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">Отмена</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}