@model GreenhouseMonitoring.Models.Event
@{
    ViewData["Title"] = "Редактировать событие";
}

<h2>Редактировать событие</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <strong>Ошибки:</strong>
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.EventId)
    @Html.HiddenFor(m => m.Timestamp)

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label">Датчик</label>
                        <select asp-for="SensorId" class="form-select" asp-items="ViewBag.Sensors">
                            <option value="">— Выберите датчик —</option>
                        </select>
                        <span asp-validation-for="SensorId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReadingId" class="form-label">ID показания</label>
                        <input asp-for="ReadingId" class="form-control" />
                        <span asp-validation-for="ReadingId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Описание</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Criticality" class="form-label">Критичность</label>
                        <select asp-for="Criticality" class="form-select">
                            <option value="low">Низкая</option>
                            <option value="medium">Средняя</option>
                            <option value="high">Высокая</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Время создания</label>
                        <input class="form-control" value="@Model.Timestamp.ToString("g")" disabled />
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Сохранить</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">Отмена</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}