@model PageViewModel<GreenhouseMonitoring.Models.Event>
@using GreenhouseMonitoring.ViewModels
@{
    ViewData["Title"] = "События";
    var filter = ViewBag.CurrentFilter as EventsFilter ?? new EventsFilter();
    var currentCriticality = filter.Criticality;
    var currentPage = filter.Page;
}

<h2>События</h2>

<!-- Уведомления -->
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Кнопка создания + фильтр -->
<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        @if (User.IsInRole("Administrator"))
        {
            <!-- ГЛАВНОЕ ИСПРАВЛЕНИЕ: передаём текущий фильтр в Create -->
            <a asp-action="Create"
               asp-route-criticality="@currentCriticality"
               class="btn btn-success">
                + Добавить событие
            </a>
        }
    </div>
    <div class="col-md-6 text-end">
        <div class="btn-group" role="group">
            <a asp-action="Index" asp-route-criticality="" asp-route-page="1"
               class="btn @(string.IsNullOrEmpty(currentCriticality) ? "btn-primary" : "btn-outline-primary")">Все</a>
            <a asp-action="Index" asp-route-criticality="high" asp-route-page="1"
               class="btn @(currentCriticality == "high" ? "btn-danger" : "btn-outline-danger")">Высокая</a>
            <a asp-action="Index" asp-route-criticality="medium" asp-route-page="1"
               class="btn @(currentCriticality == "medium" ? "btn-warning" : "btn-outline-warning")">Средняя</a>
            <a asp-action="Index" asp-route-criticality="low" asp-route-page="1"
               class="btn @(currentCriticality == "low" ? "btn-success" : "btn-outline-success")">Низкая</a>
        </div>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Событий пока нет.
        @if (User.IsInRole("Administrator"))
        {
            <text> <a asp-action="Create" asp-route-criticality="@currentCriticality">Создать первое</a></text>
        }
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Время</th>
                <th>Теплица</th>
                <th>Датчик</th>
                <th>Описание</th>
                <th>Критичность</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Items)
            {
                var rowClass = e.Criticality switch
                {
                    "high" => "table-danger",
                    "medium" => "table-warning",
                    _ => "table-success"
                };
                var badgeClass = e.Criticality switch
                {
                    "high" => "bg-danger",
                    "medium" => "bg-warning",
                    _ => "bg-success"
                };
                var criticalityText = e.Criticality switch
                {
                    "high" => "Высокая",
                    "medium" => "Средняя",
                    _ => "Низкая"
                };

                <tr class="@rowClass">
                    <td>@e.Timestamp.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@(e.Sensor?.Greenhouse?.NameNumber ?? "—")</td>
                    <td>@(e.Sensor?.Type ?? "—")</td>
                    <td>@e.Description</td>
                    <td><span class="badge @badgeClass text-white">@criticalityText</span></td>
                    <td>
                        @if (User.IsInRole("Administrator"))
                        {
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Edit" asp-route-id="@e.EventId" class="btn btn-outline-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@e.EventId" class="btn btn-outline-danger">Delete</a>
                            </div>
                        }
                        else
                        {
                            <em class="text-muted small">Только администратор</em>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Пагинация с сохранением фильтра -->
    <nav aria-label="Пагинация">
        <ul class="pagination justify-content-center mt-4">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-criticality="@currentCriticality">Назад</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><a class="page-link">Назад</a></li>
            }

            <li class="page-item disabled">
                <span class="page-link">Стр. @Model.PageNumber из @Model.TotalPages</span>
            </li>

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-criticality="@currentCriticality">Вперёд</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><a class="page-link">Вперёд</a></li>
            }
        </ul>
        <div class="text-center text-muted small">
            Всего событий: @Model.TotalItems
        </div>
    </nav>
}